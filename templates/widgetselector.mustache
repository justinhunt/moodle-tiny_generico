{{< core/modal }}
{{$title}}{{#str}} widgetsselector, tiny_generico {{/str}}{{/title}}
    {{$body}}
<div id="tiny_generico_widgets_selectorpanel" class="tiny_generico_widgets_selectorpanel">
    <form class="tiny_generico_form" id="{{uniqid}}_tiny_generico_form">
        <div class="root tab-content">
          <div>{{#str}} widgetsselector_instructions, tiny_generico {{/str}}</div>
          {{#widgets}}
            {{#showlabelsandseparator}}<hr/><div class="center">{{#str}} g1widgets_title, tiny_generico {{/str}}</div>{{/showlabelsandseparator}}
            {{#g1widgets}}
                <div id="{{uniqid}}" class="tiny_generico_widget_buttons mdl-align" style="width:30%;">
                <button style="width: 100%;" data-templateindex="{{templateindex}}" class="tiny_generico_widgetchoosebutton btn btn-info d-block">{{name}}</button>
                </div>
            {{/g1widgets}}
            {{#showlabelsandseparator}}<hr/><div class="center">{{#str}} g2widgets_title, tiny_generico {{/str}}</div>{{/showlabelsandseparator}}
            {{#g2widgets}}
                    <div id="{{uniqid}}" class="tiny_generico_widget_buttons mdl-align" style="width:30%;">
                    <button style="width: 100%;" data-templateindex="{{templateindex}}" class="tiny_generico_widgetchoosebutton btn btn-info d-block">{{name}}</button>
                    </div>
            {{/g2widgets}}
          {{/widgets}}
        </div>
    </form>
</div>
<div id="tiny_generico_widgets_optionspanel" class="tiny_generico_widgets_optionspanel tiny_generico_hidden">
</div>
    {{/body}}
    {{$footer}}
        <button type="button" class="btn btn-secondary" data-action="cancel">{{#str}} cancel {{/str}}</button>
    {{/footer}}
{{/ core/modal }}