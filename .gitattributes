# Keep development files out of camp distribution ZIPs (git archive semantics).
# The canonical release artifact is `git archive` at the tag, so this file is
# the only way to exclude something from what sites install.
.github export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.camp export-ignore
tests export-ignore
node_modules export-ignore
scss export-ignore
package.json export-ignore
package-lock.json export-ignore
.eslintignore export-ignore
